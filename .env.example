# =============================================================================
# SourceMind — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit your real .env.
# =============================================================================

# --- LLM (answer generation) ----------------------------------------------
# We use Groq's free tier. Get a free key at https://console.groq.com/keys
# (free signup, no credit card). Paste it below.
GROQ_API_KEY=gsk_your_free_key_here

# Which open-weight model Groq should serve. The default is a 70B model that
# follows "answer only from the passages, else refuse" reliably.
# For faster / higher-rate-limit responses, switch to: llama-3.1-8b-instant
LLM_MODEL=llama-3.3-70b-versatile

# --- Embeddings (local, free, no key) --------------------------------------
# Runs on your machine via sentence-transformers. Downloaded once (~130MB).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Retrieval knobs --------------------------------------------------------
# How many chunks to pull from the vector store per question.
TOP_K=8
# Grounding gate: if the best chunk's similarity is below this, refuse before
# even calling the LLM. Tuned in Phase 4 on the evaluation set.
MIN_SIMILARITY=0.30
# Hybrid retrieval: fuse BM25 keyword search with vector search (Reciprocal Rank
# Fusion). Helps terse numeric rows that embed poorly. Set false for pure vector.
USE_HYBRID=true
# RRF dampening constant (lower => more weight to each list's very top ranks).
RRF_K=60
# When a question names NO period, gently prefer the most recent filing (bounded
# tiebreak added to the fused score). An explicit year/month in the question
# disables it. Set 0 to turn off.
RECENCY_BOOST=0.01
# Cross-encoder re-ranking (OFF by default). It re-reads each (question, chunk) pair
# jointly, but on dense numeric financial tables it ranked fluent prose above the
# terse value row that holds the answer (see DECISIONS.md section 6), so we ship it
# disabled. Set true to A/B it; the model (~80MB) downloads on first query.
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=25

# --- API abuse limits ------------------------------------------------------
# /ask spends paid LLM tokens, so it is bounded: questions longer than this are
# rejected (HTTP 422) and each client IP is limited to N requests per minute
# (HTTP 429 + Retry-After). Set RATE_LIMIT_PER_MINUTE=0 to disable the limiter
# (e.g. when a reverse proxy already rate-limits).
MAX_QUESTION_CHARS=1000
RATE_LIMIT_PER_MINUTE=30

# --- Paths ------------------------------------------------------------------
DATA_DIR=./data
INDEX_DIR=./storage/index
